<script src="{{ 'lot-no-modal.js' | asset_url }}" defer="defer"></script>
{{ 'lot-no-modal.css' | asset_url | stylesheet_tag }}

<div class="cate_leftmenu">
  <div id="rottoNoSearch" class="filter-container">
    <h2 class="filter-title small-hide">商品を絞り込む</h2>
    <!-- 常にオープンの「ロットNoから年代検索」 -->
    <div class="filter-section small-hide">
      <div class="accordion open" data-toggle="rottoNoSearchWrapper">ロットNoから年代検索</div>
      <div class="panel open" id="rottoNoSearchWrapper">
        <div class="search-box">
          <form action="/collections/all" method="get" class="search-keyno-form" role="search">
            <input id="rottoNoSearchInput" type="text" name="filter.p.m.custom.production_period" class="search-input input-keyno" placeholder="例：JA-128DOA" maxlength="9">
            <button type="button" class="search-button" id="searchKeyNo"></button>
          </form>
        </div>
        <p class="info-text"><button type="button" onclick="openModalLotNoGuide()">ロットNoについて</button></p>
       
      </div>
    </div>

    {%- render 'lot-no-modal' -%}

    {% render 'facets',
      results: collection,
      enable_filtering: section.settings.enable_filtering,
      enable_sorting: section.settings.enable_sorting,
      filter_type: section.settings.filter_type,
      paginate: paginate
    %}

    {% render 'filter-by-category',mobile:false,section: section %}
  </div>
</div>

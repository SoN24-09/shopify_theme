<script>
  $(document).ready(function () {
    // get current url
    var url = window.location.href;
    // get all the links
    var links = document.querySelectorAll('.category-list a');
    // loop through all the links
    links.forEach(function (link) {
      // check if the link href is in the current url
      if (url.includes(link.href)) {
        // add class to the link
        link.classList.add('link_item--active');
      }
    });
});
</script>

<style>
  .cate_leftmenu .filter-container .category-list li .link_item--active {
    text-decoration: underline;
  }
</style>

<div class="filter-section {% unless mobile %}small-hide{% endunless %}">
    <h3 class="filter-title">カテゴリから探す</h3>
    <ul class="category-list">
      {% for category in collections %}
        {% if category.metafields.custom.level == 1 %}
          <li class="parent-accordion" style="order: {{ category.metafields.custom.sort }}">
            <div id="p-{{ category.id }}" class="sub-accordion {% if category.metafields.custom.children != blank %}has-children{% endif %}" data-toggle="cat{{ category.handle }}">
              <a class="parent-a" href="{{ category.url }}">
                {% if category.featured_image != blank %}
                  <img src="{{ category.featured_image | image_url }}" alt="{{ category.title }}">
                {% endif %}
                {{ category.title }}
              </a>
            </div>
            {% if category.metafields.custom.children != blank %}
              <div id="cat{{ category.handle }}" class="sub-panel">
                <ul>
                  {% for child_category in category.metafields.custom.children.value %}
                    <li>
                      <a href="{{ child_category.url }}">{{ child_category.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
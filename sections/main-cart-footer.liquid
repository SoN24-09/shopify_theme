<script>
  function updateCartNote(deliveryTime) {
    let currentNote = document.getElementById('Cart-note').value;
    let deliveryTimeText = document.getElementById('delivery_time').options[document.getElementById('delivery_time').selectedIndex].text;
    
    currentNote = currentNote.replace(/配送時間：.+(\n|$)/g, '');
    
    if (deliveryTime !== "0") {
      currentNote = currentNote.trim() + (currentNote ? '\n' : '') + '配送時間：' + deliveryTimeText;
    }
    
    fetch(window.Shopify.routes.root + 'cart/update.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        note: currentNote
      })
    })
    .then(response => response.json())
    .then(data => {
      document.getElementById('Cart-note').value = currentNote;
    })
    .catch((error) => {
      console.error('Error:', error);
    });
  }
</script>


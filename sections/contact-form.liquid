{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script>
  // onready disable checkbox check-agreement, when scrolled end of #terms then enable checkbox check-agreement
  $(document).ready(function () {
    var scroll = document.getElementById('terms');
    var content = document.getElementById('mCSB_1');

    scroll.onscroll = function(){
        var total = scroll.scrollTop + scroll.clientHeight;

        if(total > content.clientHeight - 100) {
           document.getElementById("agreement").removeAttribute("disabled");
        }
    }

    var isValid = false;
    $('#ContactForm').on('change', function () {
      isValid = true;
      this.querySelectorAll('.required').forEach(field => {
        if (field.value == "" || field.value == null) {
          isValid = false;
        }
      })

      if(isValid && document.getElementById("agreement").checked){
        document.getElementById("btnSubmitContact").removeAttribute("disabled");
      }else{
        document.getElementById("btnSubmitContact").setAttribute("disabled", "disabled");
      }
    });

    $('#agreement').change(function () {
      if (this.checked && isValid) {
        document.getElementById("btnSubmitContact").removeAttribute("disabled");
      } else {
        document.getElementById("btnSubmitContact").setAttribute("disabled", "disabled");
      }
    });

    $('#form_body').on('input', function () {
      if ($(this).val().length > 0) {
        $(this).siblings('.efo-input-required-check').css('display', 'block');
        $(this).css('background-color', 'white');
      } else {
        $(this).siblings('.efo-input-required-check').css('display', 'none');
        $(this).css('background-color', '#ffddde');
      }
    });

    $('#nocompany').change(function () {
      if (this.checked) {
        $('#form_company').removeClass('required');
        $('#form_company').css('background-color', 'white');
        $('#form_company').val('');
      } else {
        if ($('#form_company').val() === '') {
          $('#form_company').addClass('required');
          $('#form_company').css('background-color', '#ffddde');
        } else {
          $('#form_company').removeClass('required');
          $('#form_company').css('background-color', 'white');
        }
      }
    });

    $('#form_company').blur(function () {
      if ($(this).val() !== '') {
        $('#nocompany').prop('checked', false);
        $('#form_company').removeClass('required');
        $('#form_company').css('background-color', 'white');
      } else {
        $('#form_company').addClass('required');
        $('#form_company').css('background-color', '#ffddde');
      }
    });
  });
</script>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    <contact-form>
      {%- if section.settings.heading != blank -%}
        <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      {%- else -%}
        <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
      {%- endif -%}
      {%- liquid
        assign contact_form_class = 'isolate'
        if settings.animations_reveal_on_scroll
          assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
        endif
      -%}
      {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.post_success' | t }}
          </h2>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}


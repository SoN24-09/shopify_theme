    <div class="popup-buttons">
      <button type="button" class="btn-cancel" onclick="closePopup()">キャンセル</button>
      <button type="submit" class="btn-delete" form="deleteAccountForm">退会する</button>
    </div>
  </div>
</div>

    <!-- Add success popup -->

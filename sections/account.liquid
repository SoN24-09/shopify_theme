<script>
  document.addEventListener('DOMContentLoaded', function () {
    // if form_customer_type change to 法人, #companyName add .required to input
    const formCustomerType = document.getElementById('form_customer_type');
    const companyName = document.getElementById('companyName');
    const inputCompanyName = companyName.querySelector('input');
    const titleCompanyName = companyName.querySelector('.efo-input-title');
    const iconRequiredCompanyName = document.createElement('i');
    iconRequiredCompanyName.classList.add('icon-required');

    if (formCustomerType.value === '法人') {
      if (inputCompanyName.value === '') {
        inputCompanyName.classList.add('required', 'input-ng');
        titleCompanyName.appendChild(iconRequiredCompanyName);
      } else {
        inputCompanyName.classList.remove('required', 'input-ng');
        titleCompanyName.removeChild(iconRequiredCompanyName);
      }
    }
    formCustomerType.addEventListener('change', function () {
      if (formCustomerType.value === '法人') {
        titleCompanyName.appendChild(iconRequiredCompanyName);
        if (inputCompanyName.value === '') {
          inputCompanyName.classList.remove('required', 'input-ng');
          titleCompanyName.appendChild(iconRequiredCompanyName);
        } else {
          inputCompanyName.classList.add('required', 'input-ng');
          // titleCompanyName.removeChild(iconRequiredCompanyName);
        }
      } else {
        inputCompanyName.classList.remove('required', 'input-ng');
        titleCompanyName.removeChild(iconRequiredCompanyName);
      }
    });


    var auto_kana_1 = new AutoKana('form_firstname', 'form_firstkana', { katakana: true, toggle: false });
    var auto_kana_2 = new AutoKana('form_lastname', 'form_lastkana', { katakana: true, toggle: false });
  });
</script>


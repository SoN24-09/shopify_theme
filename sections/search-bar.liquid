<style>
  .top-search-wrapper .more-search {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

<script>
  function expandKeyNoSearch() {
    // a tag content to empty, toggle input
    var aTag = document.querySelector('.more-search a');
    aTag.innerHTML = '';
    // a tag width to initial
    aTag.style.width = 'initial';

  }

</script>

<div class="top-search-wrapper" bis_skin_checked="1">
    <div class="page-width page-width-desktop" bis_skin_checked="1">
      <div class="search-container" bis_skin_checked="1">
        <form action="{{ routes.search_url }}" method="get" role="search" >
          <input type="text" name="q" class="search-input" placeholder="商品名・キーワード・品番を入力">
          <button type="submit" class="search-button"></button>
        </form>
      </div>
    </div>
</div>
{% schema %}
{
  "name": "Search bar",
  "limit": 1,
  "settings": [
    
  ],
  "presets": [
    {
      "name": "Search bar"
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header"]
  }
}
{% endschema %}
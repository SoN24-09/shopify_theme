<script>
  // open modal about guide by value HDF9006 or HDF9008 , UDF9001
  const openModalAbout = (value) => {
    document.body.style.overflow = 'hidden';

    const modal = document.getElementById('modalAboutRegister');
    // modal.style.display = 'flex';
    showFadeIn(modal);

    const modalContent = document.getElementsByClassName('modal-guide-content')[0];
    for (let i = 0; i < modalContent.children.length; i++) {
      modalContent.children[i].style.display = 'none';
    }

    const modalMail = document.getElementsByClassName('modal-guide-' + value);
    for (let i = 0; i < modalMail.length; i++) {
      modalMail[i].style.display = 'block';
    }
  };

  // close modal about guide by value HDF9006 or HDF9008 , UDF9001
  const closeModalGuide = () => {
    document.body.style.overflow = "auto";

    const modal = document.getElementById('modalAboutRegister');
    // modal.style.display = 'none';
    hideFadeOut(modal);
    // const modalContent = document.getElementsByClassName('modal-guide-content')[0];
    // for (let i = 0; i < modalContent.children.length; i++) {
    //   modalContent.children[i].style.display = 'none';
    // }
  };

  function hideFadeOut(element) {
    if (element) {

    element.style.opacity = 0;
    element.style.transition = "opacity 0.3s ease-in-out";
    setTimeout(() => {
      element.style.display = "none";
    }, 300); // Matches the transition duration
  }
  }

  function showFadeIn(element) {
    if (element) {

      element.style.display = 'flex';
      element.style.opacity = 0;
      element.style.transition = 'opacity 0.3s ease-in-out';
      setTimeout(() => {
        element.style.opacity = 1;
      }, 10);
    }
  }

  function openPopup() {
    document.getElementById('popupOverlay').style.display = 'flex';
}

function closePopup() {
    document.getElementById('popupOverlay').style.display = 'none';
}

  // close modal when click outside
  window.onclick = function (event) {
    if (event.target.classList.contains('modal-guide')) {
      closeModalGuide();
    }
  };


  document.addEventListener('DOMContentLoaded', function () {
      const notificationServiceUse = document.getElementById('notificationServiceUse');
      const formNotificationServiceFlg1 = document.getElementById('form_notification_service_flg1');
      const formNotificationServiceFlg2 = document.getElementById('form_notification_service_flg2');
      const formCartridgeProductCode = document.getElementById('form_cartridge_product_code');
      const formFaucetProductCode = document.getElementById('form_faucet_product_code');
      const formUseStartDate = document.getElementById('form_use_start_date');

      formNotificationServiceFlg1.addEventListener('change', function () {
        if (formNotificationServiceFlg1.checked) {
          notificationServiceUse.style.display = 'block';
          if(formCartridgeProductCode.value == ''){
            formCartridgeProductCode.classList.add('required', 'input-ng');
          }
          // if(formUseStartDate.value == ''){
          //   formUseStartDate.classList.add('required', 'input-ng');
          // }
        } else {
          notificationServiceUse.style.display = 'none';
          formCartridgeProductCode.classList.remove('required', 'input-ng');
          // formFaucetProductCode.classList.remove('required', 'input-ng');
          // formUseStartDate.classList.add('required', 'input-ng');
        }
      });

      formUseStartDate.addEventListener('change', function() {
            if (formUseStartDate.value === '') {
                formUseStartDate.classList.add('required');
                formUseStartDate.classList.add('input-ng');
            } else {
                formUseStartDate.classList.remove('required');
                formUseStartDate.classList.remove('input-ng');
            }
      });


      formNotificationServiceFlg2.addEventListener('change', function () {
        if (formNotificationServiceFlg2.checked) {
          notificationServiceUse.style.display = 'none';
          formCartridgeProductCode.classList.remove('required', 'input-ng');
          // formFaucetProductCode.classList.remove('required', 'input-ng');
        } else {
          notificationServiceUse.style.display = 'block';
          // formCartridgeProductCode.classList.add('required', 'input-ng');
          // formFaucetProductCode.classList.add('required', 'input-ng');
        }
      });

      // check form_cartridge_product_code change, show or hide form_cartridge_product_code
      formCartridgeProductCode.addEventListener('change', function () {
          // hide all .select-item-list item
          const selectItemLists = document.querySelectorAll('.select-item-list');
          selectItemLists.forEach((selectItemList) => {
            selectItemList.style.display = 'none';
          });

          // get value of form_cartridge_product_code
          const value = formCartridgeProductCode.value;
          const item = document.getElementById(value);
          if (item) {
            item.style.display = 'block';
          }
      });

      // if form_customer_type change to 法人, #companyName add .required to input
      // const formCustomerType = document.getElementById('form_customer_type');
      // const companyName = document.getElementById('companyName');
      // const input = companyName.querySelector('input');
      // const title = companyName.querySelector('.efo-input-title');
      // const iconRequired = document.createElement('i');
      // iconRequired.classList.add('icon-required');
      // formCustomerType.addEventListener('change', function () {
      //   if (formCustomerType.value === '法人') {
      //     input.classList.add('required', 'input-ng');
      //     title.appendChild(iconRequired);
      //   } else {
      //     input.classList.remove('required', 'input-ng');
      //     title.removeChild(iconRequired);
      //   }
      // });


    const notificationServiceFlg = document.querySelectorAll('input[name="notification_service_flg"]');
    const cartridgeProductCode = document.getElementById('form_cartridge_product_code');
    const useStartDate = document.getElementById('form_use_start_date');
    notificationServiceFlg.forEach((element) => {
        element.addEventListener('change', function() {
            if (element.value === '1') {
              if (!cartridgeProductCode.value) {
                cartridgeProductCode.classList.add('required');
                cartridgeProductCode.classList.add('input-ng');
              }
              if (useStartDate.value === '') {
                useStartDate.classList.add('required');
                useStartDate.classList.add('input-ng');
              }
            } else {
                cartridgeProductCode.classList.remove('required');
                cartridgeProductCode.classList.remove('input-ng');
                useStartDate.classList.remove('required');
                useStartDate.classList.remove('input-ng');
            }
        });
    });


    // onchange tel1, tel2, tel3, concat value to hidden input tel
    const tel1 = document.getElementById('form_tel1');
    const tel2 = document.getElementById('form_tel2');
    const tel3 = document.getElementById('form_tel3');
    const phone1011Warning = document.getElementById('phone1011Warning');
    const phoneCheckBelow = document.getElementById('phoneCheckBelow');
    const tel = document.querySelector('input[name="tel"]');
    const telItems = document.querySelectorAll('.tel-item');
    // onchange
    telItems.forEach(item => {
       
        item.addEventListener('input', () => {
            var telTotal = tel1.value.length + tel2.value.length + tel3.value.length;
            tel.value = `${tel1.value}-${tel2.value}-${tel3.value}`;

           
        });

       item.addEventListener('change', () => {
        var telTotal = tel1.value.length + tel2.value.length + tel3.value.length;
        if (tel1.value !== '' && tel2.value !== '' && tel3.value !== '') {
          
          
          if (telTotal == 10 || telTotal == 11) {
             phone1011Warning.style.display = 'none';
             phoneCheckBelow.removeAttribute("style");
          } else {
            phone1011Warning.style.display = 'block';
            phoneCheckBelow.style.display = 'none';
            //  if (item.value.length < 3) {
            //   item.classList.add('required, input-ng');
            // } else {
            //   item.classList.remove('required, input-ng');
            // }
            
          }
        }
      });
    });


      var auto_kana_1 = new AutoKana('form_firstname', 'form_firstkana', { katakana: true, toggle: false });
      var auto_kana_2 = new AutoKana('form_lastname', 'form_lastkana', { katakana: true, toggle: false });
  });

</script>

<div class="customer register section-{{ section.id }}-padding">
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  <p>{{ 'customer.register.description' | t | newline_to_br }}</p>
  <register-form>
    <form>
      <input type="hidden" id="inputTriggerForm" class="hidden" value="" />
      
      <div class="efo-form input">
        <div class="efo-form-container">
          <div class="efo-input-container">
            <!-- 個人・法人 -->
            <div class="efo-input-row">
              <div class="efo-input-title">
                <label>個人・法人</label>
                <i class="icon-required"></i>
              </div>
              <div class="efo-input-content">
                <div class="efo-input-wrap">
                  <select id="form_customer_type" class="required" name="job">
                    <option value="個人">個人</option>
                    <option value="法人">法人</option>
                  </select>
                  <label for="form_customer_type" class="efo-dummy-select">選択してください</label>
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- 法人名 -->
            <div class="efo-input-row" id="companyName">
              <div class="efo-input-title">
                <label>法人名</label>
              </div>
              <div class="efo-input-content">
                <div class="efo-input-wrap">
                  <input
                    placeholder="例：株式会社〇〇〇〇〇〇"
                    maxlength="50"
                    class="efo-input-sm input-ng"
                    data-convert="zenkaku"
                    name="company"
                    value=""
                    type="text"
                    id="form_company"
                  >
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- お名前 -->
            <div class="efo-input-row">
              <div class="efo-input-title">
                <label>姓・名</label>
                <i class="icon-required"></i>
              </div>
              <div class="efo-input-content" style="display: flex;">
                <div class="efo-input-wrap">
                  <input
                    placeholder="例：山田"
                    maxlength="20"
                    class="efo-input-sm required input-ng"
                    data-convert="zenkaku"
                    name="first_name"
                    type="text"
                    id="form_firstname"
                  >
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
                <div class="efo-input-wrap">
                  <input
                    placeholder="例：太郎"
                    maxlength="20"
                    class="efo-input-sm required input-ng"
                    data-convert="zenkaku"
                    name="last_name"
                    type="text"
                    id="form_lastname"
                  >
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- お名前（フリガナ） -->
            <div class="efo-input-row">
              <div class="efo-input-title">
                <label>姓・名（フリガナ）</label>
              </div>
              <div class="efo-input-content" style="display: flex">
                <div class="efo-input-wrap">
                  <input
                    placeholder="例：ヤマダ"
                    maxlength="20"
                    class="efo-input-sm input-ng furigana_name"
                    data-efo="全角カタカナで入力してください"
                    data-validate="kana"
                    data-convert="zenkaku"
                    name="furigana_first_name"
                    value=""
                    type="text"
                    id="form_firstkana"
                  >
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
                <div class="efo-input-wrap">
                  <input
                    placeholder="例：タロウ"
                    maxlength="20"
                    class="efo-input-sm input-ng furigana_name"
                    data-efo="全角カタカナで入力してください"
                    data-validate="kana"
                    data-convert="zenkaku"
                    name="furigana_last_name"
                    value=""
                    type="text"
                    id="form_lastkana"
                  >
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- 郵便番号 -->
            <div class="efo-input-row">
              <div class="efo-input-title">
                <label>郵便番号</label>
                <i class="icon-required"></i>
              </div>

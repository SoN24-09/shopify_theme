              <div class="efo-input-title" >
                <label>電話番号</label>
                <i class="icon-required"></i>
              </div>
              <div class="efo-input-content" >
                <div class="efo-input-wrap" >
                  <input placeholder="例：09012345678" maxlength="14" class="efo-input-sm required input-ng" data-efo="半角数字・ハイフンなしで入力してください" data-validate="tel" name="tel" value="" type="text" id="form_tel">
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- FAX（記号なし） -->
            <div class="efo-input-row" >
              <div class="efo-input-title" >
                <label>FAX</label>
              </div>
              <div class="efo-input-content" >
                <div class="efo-input-wrap" >

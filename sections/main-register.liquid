                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- メールアドレス -->
            <div class="efo-input-row" >
              <div class="efo-input-title" >
                <label>メールアドレス</label>
                <i class="icon-required"></i>
              </div>
              <div class="efo-input-content" >
                <div class="efo-input-wrap" >
                  <input placeholder="例：sample.@gmail.com" maxlength="50" class="efo-input-md required input-ng" data-efo="半角英数字で入力してください" data-validate="email" name="email" value="" type="text" id="form_email">
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- メールマガジン -->
            {% comment %} <div class="efo-input-row" style="display:none;" >
              <div class="efo-input-title" >
                <label for="efo-form01-input-radio1">メールマガジン</label>
                <i class="icon-required"></i>
              </div>
              <div class="efo-input-content" >

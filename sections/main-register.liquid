            <input type="hidden" value="" name="mino" />
            <input type="hidden" value="" name="cktr" />
            <input type="hidden" value="" name="rank" />
            <div class="efo-input-row hmk-field">
              <div class="efo-input-title" >
                <label for="form_introduction_code">品目</label>
              </div>
              <div class="efo-input-content" >
                <div class="efo-input-wrap" style="display: flex;flex-wrap: wrap;gap: 8px;" >
                  <div>
                    <input type="checkbox" id="HMK1" name="hmk" value="ドア・クローゼット"/>
                    <label for="HMK1">ドア・クローゼット</label>
                  </div>
                  <div>
                    <input type="checkbox" id="HMK2" name="hmk" value="床・段階"/>
                    <label for="HMK2">床・段階</label>
                  </div>
                  <div>
                    <input type="checkbox" id="HMK3" name="hmk" value="収納"/>
                    <label for="HMK3">収納</label>
                  </div>
                  <div>
                    <input type="checkbox" id="HMK4" name="hmk" value="キッチン・洗面"/>
                    <label for="HMK4">キッチン・洗面</label>
                  </div>
                  <div>
                    <input type="checkbox" id="HMK5" name="hmk" value="その他"/>
                    <label for="HMK5">その他</label>

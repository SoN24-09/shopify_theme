                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
              <!-- 建物名 -->
              <div class="efo-input-row" >
                <div class="efo-input-title" >
                  <label>建物名</label>
                </div>
                <div class="efo-input-content" >
                  <div class="efo-input-wrap" >
                    <input placeholder="例：○○ビル 101号室" maxlength="100" class="efo-input-md input-ng" id="address3" data-efo="例：○○ビル 101号室" name="address2" value="" type="text">
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
              <!-- 電話番号（記号なし） -->

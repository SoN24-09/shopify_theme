                    <div class="bg-gray" >
                      <ul class="panel-layout">
                        <li>
                          <label class="radio-red">
                            <input id="form_mail_magazine_flg1" name="mail_magazine_flg" value="1" checked="checked" type="radio">希望する </label> &nbsp;&nbsp;
                        </li>
                        <li>

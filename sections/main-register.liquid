                    data-validate="password" 
                    type="password" 
                    name="password"
                    value="" 
                    id="form_password"
                  >
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
                <!-- End .efo-input-wrap -->
                <p class="view-password">

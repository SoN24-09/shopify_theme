                    <option value="2024">2024年</option>
                    <option value="2025">2025年</option>
                  </select>
                  <label for="form_construction_year" class="efo-dummy-select">選択してください</label>
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
              </div>
            </div>
            <!-- End .efo-input-row -->
            <!-- 施⼯業者名 -->
            <div class="efo-input-row" >
              <div class="efo-input-title" >
                <label for="form_construction_name">施⼯業者名</label>
              </div>
              <div class="efo-input-content" >
                <div class="efo-input-wrap" >
                  <input placeholder="例：□□□□ホーム" maxlength="50" class="efo-input-sm input-ng" name="builders" value="" type="text" id="form_construction_name">
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
                <!-- End .efo-input-wrap -->
              </div>
              <!-- End .efo-input-content -->
            </div>
            <!-- End .efo-input-row -->
            <!-- 紹介コード -->
            <div class="efo-input-row" >
              <div class="efo-input-title" >
                <label for="form_introduction_code">紹介コード</label>
              </div>
              <div class="efo-input-content" >
                <div class="efo-input-wrap" >
                  <input placeholder="例：07535" maxlength="8" class="efo-input-sm input-ng" data-validate="number" name="referral_code" value="" type="text" id="form_introduction_code">
                  <p class="efo-input-message"></p>
                  <i class="efo-input-required-check"></i>
                </div>
                <!-- End .efo-input-wrap -->
              </div>
              <!-- End .efo-input-content -->

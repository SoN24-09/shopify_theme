{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'efo-form.css' | asset_url | stylesheet_tag }}
<script src="https://unpkg.com/wanakana"></script>
<script src="https://ajaxzip3.github.io/ajaxzip3.js" charset="UTF-8"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>



{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;ạ
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  <p>{{ 'customer.register.description' | t | newline_to_br }}</p>
  <register-form>
    <form>
        <div class="efo-form input" >
          <div class="efo-form-container" >
            <div class="efo-input-container" >
              <!-- 個人・法人 -->
              <div class="efo-input-row" >
                <div class="efo-input-title" >
                  <label>個人・法人</label>
                  <i class="icon-required"></i>
                </div>
                <div class="efo-input-content" >
                  <div class="efo-input-wrap" >
                    <select id="form_customer_type" class="required input-ng" name="job">
                      <option value="">選択してください</option>
                      <option value="個人">個人</option>
                      <option value="法人">法人</option>
                    </select>
                    <label for="form_customer_type" class="efo-dummy-select">選択してください</label>
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
              <!-- 法人名 -->
              <div class="efo-input-row" >
                <div class="efo-input-title" >
                  <label>法人名</label>
                </div>
                <div class="efo-input-content" >
                  <div class="efo-input-wrap" >
                    <input placeholder="例：株式会社〇〇〇〇〇〇" maxlength="50" class="efo-input-sm input-ng" data-convert="zenkaku" name="company" value="" type="text" id="form_company">
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
              <!-- お名前 -->
              <div class="efo-input-row" >
                <div class="efo-input-title" >
                  <label>姓・名</label>
                  <i class="icon-required"></i>
                </div>
                <div class="efo-input-content" style="display: flex;">
                  <div class="efo-input-wrap" >
                    <input placeholder="例：山田" 
                      maxlength="20" 
                      class="efo-input-sm required input-ng"
                      data-convert="zenkaku" 
                      name="first_name"
                      onkeyup="document.getElementById('form_firstkana').value = wanakana.toKatakana(document.getElementById('form_firstname').value)"
                      type="text" 
                      id="form_firstname">
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                  <div class="efo-input-wrap" >
                    <input placeholder="例：太郎" 
                      maxlength="20" 
                      class="efo-input-sm required input-ng"
                      data-convert="zenkaku" 
                      name="last_name"
                      onkeyup="document.getElementById('form_lastkana').value = wanakana.toKatakana(document.getElementById('form_lastname').value)"
                      type="text" 
                      id="form_lastname">
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
              <!-- お名前（フリガナ） -->
              <div class="efo-input-row" >
                <div class="efo-input-title" >
                  <label>姓・名（フリガナ）</label>
                </div>
                <div class="efo-input-content" style="display: flex">
                  <div class="efo-input-wrap" >
                    <input placeholder="例：ヤマダ" maxlength="20" class="efo-input-sm input-ng" data-efo="全角カタカナで入力してください" data-validate="kana" data-convert="zenkaku" name="furigana_first_name" value="" type="text" id="form_firstkana">
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                  <div class="efo-input-wrap" >
                    <input placeholder="例：タロウ" maxlength="20" class="efo-input-sm input-ng" data-efo="全角カタカナで入力してください" data-validate="kana" data-convert="zenkaku" name="furigana_last_name" value="" type="text" id="form_lastkana">
                    <p class="efo-input-message"></p>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
              <!-- 郵便番号 -->
              <div class="efo-input-row" >
                <div class="efo-input-title" >
                  <label>郵便番号</label>
                  <i class="icon-required"></i>
                </div>
                <div class="efo-input-content" >
                  <div class="efo-input-wrap" >
                    <input placeholder="例：1234567" maxlength="7" class="efo-input-zip required input-ng" id="zip" data-efo="半角数字・ハイフンなしで入力してください" data-validate="zip" name="zip" value="" type="text">
                    <p class="efo-input-message"></p>
                    <!--モーダルで表示させる要素-->
                    <div style="display: none;" >
                      <div id="inline-content" class="formItem" >
                        <div class="inner" >
                          <h3>住所の選択</h3>
                          <p class="ttl">郵便番号に該当する住所</p>
                          <ul class="clearfix"></ul>
                        </div>
                      </div>
                    </div>
                    <button type="button" class="efo-search-address" data-zip="zip" data-pref="pref" data-address="address">
                      <span>郵便番号から住所を検索</span>
                    </button>
                    <i class="efo-input-required-check"></i>
                  </div>
                </div>
              </div>
              <!-- End .efo-input-row -->
